      "required_literal": "SYNTHETIC — NO HUMAN PARTICIPANT OR HUMAN DATA",
      "replaces_human_consent": true,
      "forbids_human_consent_form": true,
      "forbids_human_result_claim": true,
      "required_fields": [
        "packet_id_version",
