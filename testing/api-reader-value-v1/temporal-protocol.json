      "STAGE_B_CONTEXT_MANIFEST_VERIFIED",
      "STAGE_B_STARTED",
      "SCORING_ENDED",
      "DEBRIEF_INPUT_MANIFEST_VERIFIED",
      "DEBRIEF_COMPLETED",
      "STAGE_B_ENDED",
      "RUN_RESULTS_COMPLETED",
      "LOG_CLOSED"
    ],
    "results_completion_precedes_log_close": true,
    "external_closeout_is_later": true
  },
  "next_release_bindings": [
    "governed_artifacts",
    "governing_manifest",
    "detached_verification_record"
  ],
  "entry_branches": {
    "selection_required": true,
    "mutually_exclusive": true,
