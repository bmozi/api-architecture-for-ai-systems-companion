{
  "schema_version": 3,
  "protocol_id": "RV-TEMPORAL-FREEZE-001",
  "packet_id": "API-RV-PILOT-001",
  "packet_version": "1.2.5",
  "causal_order": [
    "completed_artifacts",
    "artifact_only_manifest",
    "successful_manifest_verification",
    "detached_verification_record",
    "next_release_manifest"
  ],
  "governing_manifest_members": [
    "governed_artifacts"
  ],
  "governing_manifest_excludes": [
    "governing_manifest",
    "detached_verification_record"
  ],
  "verification": {
    "must_succeed": true,
    "observed_timestamp_timezone_required": true,
    "required_observation_fields": [
      "exact_command",
      "complete_output",
      "exit_code",
      "timestamp",
      "timezone"
    ]
  },
  "detached_record": {
    "created_after": "successful_manifest_verification",
    "excluded_from_described_manifest": true,
    "claims_self_hash": false,
    "required_fields": [
      "attempt_id",
      "phase",
      "artifact_actor",
      "facilitator",
      "manifest_verifier",
      "exact_verification_command",
      "complete_observed_output",
      "exit_code",
      "verification_timestamp",
      "verification_timezone",
      "record_completing_actor",
      "record_completion_timestamp",
      "record_completion_timezone"
    ],
    "record_completion_must_follow_verification": true
  },
  "participant_input_policy": {
    "declared_route_files_only": true,
    "undeclared_orchestration_forbidden": true,
    "forbidden_examples": [
      "ORCHESTRATION.md",
      "run note",
      "hidden prompt",
      "facilitator file"
    ],
    "synthetic_orchestration_requires_prior_immutable_manifest": true,
    "synthetic_orchestration_manifest": "ORCHESTRATION-INPUT-SHA256SUMS"
  },
  "execution_access_log": {
    "path": "facilitator-only/05-execution-and-access-log.md",
    "facilitator_only": true,
    "excluded_from_participant_input": true,
    "continuity_binding_required": true,
    "required_event_sequence": [
      "SEALED_INPUT_MANIFEST_CREATED",
      "SEALED_INPUT_MANIFEST_VERIFIED",
      "PHASE_GATE_OPENED",
      "FILE_OPENED_OR_ACCESS_ATTEMPT_RECORDED",
      "ARTIFACT_COMPLETED",
      "GOVERNING_MANIFEST_CREATED",
      "GOVERNING_MANIFEST_VERIFIED",
      "DETACHED_RECORD_COMPLETED",
      "NEXT_RELEASE_MANIFEST_CREATED",
      "NEXT_RELEASE_MANIFEST_VERIFIED",
      "NEXT_PHASE_GATE_OPENED"
    ],
    "required_row_fields": [
      "event_id",
      "prior_event_id",
      "phase",
      "event_type",
      "filename_or_surface",
      "actor",
      "facilitator",
      "timestamp",
      "timezone",
      "verification_command",
      "complete_observed_output",
      "exit_code",
      "continuity_binding",
      "outcome_or_deviation"
    ],
    "required_route_boundaries": [
      "RUN_STARTED",
      "ENTRY_BRANCH_SELECTED",
      "STAGE_A_CONTEXT_MANIFEST_VERIFIED",
      "STAGE_A_STARTED",
      "STAGE_A_FEEDBACK_COMPLETED",
      "STAGE_A_ENDED",
      "STAGE_B_CONTEXT_MANIFEST_VERIFIED",
      "STAGE_B_STARTED",
      "SCORING_ENDED",
      "DEBRIEF_INPUT_MANIFEST_VERIFIED",
      "DEBRIEF_COMPLETED",
      "STAGE_B_ENDED",
      "RUN_RESULTS_COMPLETED",
      "LOG_CLOSED"
    ],
    "results_completion_precedes_log_close": true,
    "external_closeout_is_later": true
  },
  "next_release_bindings": [
    "governed_artifacts",
    "governing_manifest",
    "detached_verification_record"
  ],
  "entry_branches": {
    "selection_required": true,
    "mutually_exclusive": true,
